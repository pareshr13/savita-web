# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://www.savitaitsolutions.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@savitaitsolutions.com
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
NEXT_PUBLIC_WHATSAPP=910000000000
NEXT_PUBLIC_CITY=Ahmedabad
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_X=
NEXT_PUBLIC_GITHUB=

# ---------- SEO & analytics (optional) ----------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# ---------- Lead collection ----------
# Leads are always appended to this JSON Lines file when the filesystem is writable (VPS / Docker).
LEADS_FILE=./data/leads.jsonl

# Email notification for every enquiry (recommended)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Savita IT Solutions <no-reply@savitaitsolutions.com>"
LEAD_NOTIFY_TO=sales@savitaitsolutions.com
SEND_AUTOREPLY=true

# Optional: POST every lead as JSON to a webhook (Google Sheets Apps Script, Zapier, Make, n8n, Slack, CRM)
LEAD_WEBHOOK_URL=
