# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://tradingaisoftware.com
NEXT_PUBLIC_CONTACT_EMAIL=info@tradingaisoftware.com
NEXT_PUBLIC_CONTACT_PHONE=+91 84607 71378
NEXT_PUBLIC_WHATSAPP=918460771378
NEXT_PUBLIC_CITY=Gandhinagar
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_X=
NEXT_PUBLIC_GITHUB=

# ---------- SEO & analytics (optional) ----------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# ---------- Lead collection ----------
# Leads are always appended to this JSON Lines file when the filesystem is writable (VPS / Docker).
LEADS_FILE=./data/leads.jsonl

# Email notification for every enquiry (recommended)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Trading AI Software <no-reply@tradingaisoftware.com>"
LEAD_NOTIFY_TO=info@tradingaisoftware.com
SEND_AUTOREPLY=true

# Optional: POST every lead as JSON to a webhook (Google Sheets Apps Script, Zapier, Make, n8n, Slack, CRM)
LEAD_WEBHOOK_URL=

# ---------- Static hosting (GitHub Pages) ----------
# Set automatically by .github/workflows/deploy.yml. For a local static build:
#   STATIC_EXPORT=true NEXT_PUBLIC_STATIC_SITE=true npm run build   (output in ./out)
# Free Web3Forms access key (https://web3forms.com) — emails each enquiry to you.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Or any JSON form endpoint (Formspree, Google Apps Script, n8n, CRM)
NEXT_PUBLIC_FORM_ENDPOINT=
